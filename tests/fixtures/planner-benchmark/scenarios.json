{
  "schemaVersion": 1,
  "description": "Planner benchmark scenarios. Ground truth is graded, not exact-match: a selection is judged against required / acceptable / irrelevant / forbidden role sets, because more than one defensible Skill team exists for most goals.",
  "gradingContract": {
    "requiredRoles": "Roles a competent plan must cover. Drives role recall.",
    "acceptableRoles": "Roles that are reasonable to include. Neither rewarded nor penalized.",
    "irrelevantRoles": "Roles a competent plan should not select for this goal. Drives the irrelevant selection rate.",
    "forbiddenSkills": "Specific Skill ids that must never be admitted. A single occurrence is a hard failure.",
    "riskMustBe": "When set, Forge's effective risk must equal this value regardless of what the provider proposed. When null, risk is recorded but not scored, because a deterministic provider cannot assess risk.",
    "expectedRoleOrder": "When set, these roles must appear in this relative order in the admitted selection.",
    "kind": "selection scores plan quality; policy scores whether Forge correctly refuses to produce a plan."
  },
